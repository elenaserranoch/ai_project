      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Cargar el dataset\n",
        "try:\n",
        "    df = pd.read_csv('hotel_bookings.csv')\n",
        "except FileNotFoundError:\n",
        "    print(\"Error: 'hotel_bookings.csv' no se encontró. Asegúrate de que el archivo esté en la ruta correcta.\")\n",
        "    # Optionally, you might want to stop execution or load a sample dataset\n",
        "    # For this example, we'll create a dummy DataFrame if the file isn't found\n",
        "    data = {\n",
        "        'hotel': ['Resort Hotel', 'City Hotel'],\n",
        "        'is_canceled': [0, 1],\n",
        "        'lead_time': [342, 7],\n",
        "        'adults': [2, 1],\n",
        "        'children': [0.0, np.nan],\n",
        "        'babies': [0, 0],\n",
        "        'meal': ['BB', 'BB'],\n",
        "        'country': ['PRT', 'PRT'],\n",
        "        'market_segment': ['Direct', 'Direct'],\n",
        "        'deposit_type': ['No Deposit', 'No Deposit'],\n",
        "        'reservation_status': ['Check-Out', 'Canceled'],\n",
        "        'reservation_status_date': ['2015-07-01', '2015-07-01']\n",
        "    }\n",
        "    df = pd.DataFrame(data)\n",
        "    print(\"Se cargó un DataFrame de ejemplo debido a que 'hotel_bookings.csv' no se encontró.\")\n",
        "\n",
        "\n",
        "# Manejar valores nulos en la columna 'children': rellenar con 0\n",
        "df['children'] = df['children'].fillna(0)\n",
        "\n",
        "# Convertir 'children' a tipo entero después de rellenar los NaNs\n",
        "df['children'] = df['children'].astype(int)\n",
        "\n",
        "# Eliminar filas donde el número total de huéspedes (adultos + children + babies) es 0\n",
        "# Primero, asegurarnos de que 'adults' y 'babies' también sean enteros si no lo son\n",
        "df['adults'] = df['adults'].astype(int)\n",
        "df['babies'] = df['babies'].astype(int)\n",
        "\n",
        "# Crear una copia para evitar SettingWithCopyWarning en operaciones futuras\n",
        "df_cleaned = df[~((df['adults'] == 0) & (df['children'] == 0) & (df['babies'] == 0))].copy()\n",
        "\n",
        "print(f\"Forma original del DataFrame: {df.shape}\")\n",
        "print(f\"Forma del DataFrame después de eliminar reservas con cero huéspedes: {df_cleaned.shape}\")\n",
        "\n",
        "display(df_cleaned.head())"
      ],
